{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shun-chat-p2p-relay",
  "main": "party/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://shun-chat-p2p.vercel.app"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ChatSignalingServer",
        "class_name": "ChatSignalingServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatSignalingServer"]
    }
  ]
}

