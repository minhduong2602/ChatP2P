# VITE_PARTYKIT_HOST: Host URL of your deployed PartyKit signaling server.
# After running `npm run party:deploy`, PartyKit provides a domain like:
# "shun-chat-p2p-signaling.<your-username>.partykit.dev"
# For local dev, leave it unset or use "localhost:1999" (starts with `npm run party:dev`).
VITE_PARTYKIT_HOST=""

# Configure these on PartyKit only, never as VITE_ variables:
# APP_PASSWORD: owner password. Required; missing value denies all access.
# APP_URL: exact public app URL used to allow browser API calls (for example https://chat.example.com).
# In local PartyKit development, APP_URL may be unset for localhost/127.0.0.1.
# Set production values with:
# npx partykit env add APP_PASSWORD
# npx partykit env add APP_URL
